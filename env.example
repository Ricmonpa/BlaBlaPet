# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Gemini AI (server-only, NO prefix VITE_): used by api/gemini.js and api/live-token.js
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary server-side (api/upload-video-cloudinary.js). NEVER prefix secrets with VITE_
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# App Config
VITE_DAILY_VIDEO_LIMIT=25
VITE_APP_NAME=Yo Pett
VITE_APP_VERSION=1.0.0

# External API Configuration (fallback)
VITE_TRANSLATOR_API_URL=http://localhost:3001/api

# Vercel Blob Configuration (legacy - opcional)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

